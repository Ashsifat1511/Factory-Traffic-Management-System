{
  "name": "ftms",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "dev": "npm run dev -w apps/server",
    "scenario": "tsx scripts/scenarios.ts",
    "postman": "tsx scripts/postman.ts",
    "db:migrate": "npm run migrate -w @ftms/server",
    "db:seed": "npm run seed -w @ftms/server",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "certs:dev": "tsx scripts/mqtt-setup.ts certs",
    "mqtt:users": "tsx scripts/mqtt-setup.ts users"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@types/node": "^26.6.4",
    "dependency-cruiser": "^18.5.0",
    "fast-check": "^4.10.2",
    "oxlint": "^1.87.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
