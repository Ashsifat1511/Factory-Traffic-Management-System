NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# PostgreSQL (docker compose maps it to localhost:5433). Owner runs migrations; the app role runs the server.
DATABASE_URL=postgres://ftms_app:ftms_app_dev@localhost:5433/ftms
DATABASE_OWNER_URL=postgres://ftms_owner:ftms_owner_dev@localhost:5433/ftms
DB_OWNER_PASSWORD=ftms_owner_dev
DB_APP_PASSWORD=ftms_app_dev

# Security
DASHBOARD_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
DEVICE_KEY_PEPPER=change-me-to-32-random-bytes-base64
SEED_ADMIN_PASSWORD=admin-password-123
SEED_OPERATOR_PASSWORD=operator-password-123
SEED_VIEWER_PASSWORD=viewer-password-123

# Simulation (never enable in production)
SIMULATION_MODE=true
ALLOW_SIMULATION_IN_PRODUCTION=false

# Controller link
CONTROLLER_TRANSPORT=rest
CONTROLLER_SIM_URL=http://localhost:8090
BACKEND_TO_SIM_TOKEN=change-me-random-token
BACKEND_URL=http://localhost:8080
SIM_JUNCTIONS=A
